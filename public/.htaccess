<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Apache/PHP-FPM kann den Authorization-Header vor PHP entfernen.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API-Requests (außer proxy.php) → server-php/index.php
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/api/proxy\.php [NC]
    RewriteRule ^api/(.*)$ api/backend.php [QSA,L]

    # Statische Dateien direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA-Fallback: alle anderen Requests → index.html
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

</IfModule>
